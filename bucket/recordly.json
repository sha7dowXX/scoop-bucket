    "url": "https://github.com/webadderallorg/Recordly/releases/download/v1.3.3/Recordly-windows-x64.exe",
    "hash": "5dedfaf900ca3b37be9328e871ee0192c67761148b89570ab115c8dad1a71a1b",
    "installer": {
        "script": [
            "Start-Process -FilePath \"$dir\\Recordly-windows-x64.exe\" -ArgumentList '/S' -Wait",
            "if (Test-Path \"$env:LOCALAPPDATA\\Programs\\recordly\\Recordly.exe\") {",
            "    New-Item -ItemType SymbolicLink -Path \"$dir\\Recordly.exe\" -Target \"$env:LOCALAPPDATA\\Programs\\recordly\\Recordly.exe\" -Force | Out-Null",
            "}"
        ]
    },
    "bin": "Recordly.exe",
    "uninstaller": {
        "script": [
            "$uninstallPath = \"$env:LOCALAPPDATA\\Programs\\recordly\\Uninstall Recordly.exe\"",
            "if (Test-Path $uninstallPath) { Start-Process -FilePath $uninstallPath -ArgumentList '/S' -Wait }"
        ]
    },
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/webadderallorg/Recordly/releases/download/v$version/Recordly-windows-x64.exe",
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt",
            "regex": "$sha256  Recordly-windows-x64\\.exe"
        }
    }
}
